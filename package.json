{
  "name": "sigma16-compiler-modern",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "wasm-branch": "git config -f .gitmodules submodule.lib/sigma16-compiler.branch",
    "wasm-update": "git submodule update --remote lib/sigma16-compiler",
    "wasm-build": "wasm-pack build ./lib/sigma16-compiler/s16-wasm --target web",
    "wasm": "npm run wasm-update && npm run wasm-build",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.4.2",
    "@tauri-apps/plugin-fs": "^2.4.4",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-shell": "^2.3.3",
    "golden-layout": "^2.6.0",
    "monaco-editor": "^0.54.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.6",
    "s16-wasm": "file:./lib/sigma16-compiler/s16-wasm/pkg"
  },
  "devDependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/cli": "^2",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.6",
    "@types/react-dom": "^19.2.0",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^8.55.0",
    "eslint-plugin-react": "^7.33.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^7.2.4"
  }
}